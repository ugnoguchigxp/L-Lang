{
  "name": "staged-semantic-typescript-mvp",
  "version": "0.0.0",
  "description": "Write meaning once and compile it into context-specific, deterministic TypeScript with LLM flexibility at build time.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "semantic": "bun run src/semantic-cli.ts",
    "semantic:test": "bun run semantic test examples/active-customer/semantic.ts",
    "semantic:test:customer-schema": "bun run semantic test examples/semantic-polymorphism/customer/semantic.ts",
    "semantic:test:account-schema": "bun run semantic test examples/semantic-polymorphism/account/semantic.ts",
    "semantic:tdd:fixture": "bun run semantic tdd-build examples/active-customer/semantic.ts --test-fixture examples/active-customer/semantic-test-response.fixture.json --fixture examples/active-customer/openai-response.fixture.json",
    "semantic:tdd:replay": "bun run semantic tdd-replay examples/active-customer/semantic.ts",
    "semantic:tdd:test": "bun run semantic tdd-test examples/active-customer/semantic.ts",
    "semantic:fulfillment:test": "bun test examples/order-fulfillment/order-fulfillment.test.ts",
    "semantic:fulfillment:closure": "bun run semantic closure examples/order-fulfillment/semantic-closure.json",
    "semantic:judgment:fixture": "bun run semantic build examples/static-judgment/semantic.ts --fixture examples/static-judgment/openai-response.true.fixture.json",
    "semantic:judgment:replay": "bun run semantic replay examples/static-judgment/semantic.ts",
    "semantic:explain": "bun run semantic explain examples/active-customer/semantic.ts",
    "semantic:judgment:explain": "bun run semantic explain examples/static-judgment/semantic.ts",
    "semantic:closure": "bun run semantic closure semantic-closure.json",
    "semantic:verify": "bun run semantic verify semantic-closure.json",
    "benchmark:cross-schema": "bun run src/cross-schema-benchmark-cli.ts benchmarks/cross-schema/benchmark.json",
    "benchmark:schema-evolution": "bun run src/schema-evolution-benchmark-cli.ts benchmarks/schema-evolution/benchmark.json",
    "benchmark:static-judgment:fixture": "bun run src/static-judgment-benchmark-cli.ts fixture",
    "project-fit:fixture": "bun run src/project-fit-cli.ts fixture benchmarks/project-fit-v2/benchmark.json",
    "project-fit:benchmark": "bun run src/project-fit-cli.ts benchmark benchmarks/project-fit-v2/benchmark.json",
    "pilot:run": "bun run src/pilot-cli.ts run",
    "pilot:freeze": "bun run src/pilot-cli.ts freeze",
    "pilot:report": "bun run src/pilot-cli.ts report",
    "pilot:consensus": "bun run src/pilot-consensus-cli.ts",
    "generate": "bun run src/cli.ts generate examples/active-customer/predicate.ir.json --out artifacts/active-customer/predicate.generated.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:sharded",
    "test:sharded": "bun run src/run-tests-sharded.ts",
    "coverage": "bun run src/run-coverage.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "ci:smoke": "bun run semantic explain examples/active-customer/semantic.ts --json && bun run semantic verify semantic-closure.json --json && bun run ci:llang-smoke && bun run ci:module-smoke && bun run ci:effects-smoke",
    "ci:protected": "bun run src/verify-protected-inputs.ts",
    "ci:docs": "bun run src/verify-markdown-links.ts && bun run src/verify-doc-contracts.ts",
    "verify": "bun run src/cli.ts verify examples/active-customer/predicate.ir.json --out artifacts/active-customer/predicate.generated.ts",
    "llm:verify": "bun run src/llm-harness.ts examples/active-customer/llm-harness.json",
    "llm:verify:fixture": "bun run src/llm-harness.ts examples/active-customer/llm-harness.json --fixture examples/active-customer/openai-response.fixture.json",
    "wasm": "bun run src/wasm-cli.ts",
    "hybrid": "bun run src/hybrid-cli.ts",
    "hybrid:demo": "bun run examples/hybrid-wasm-scenarios/run.ts",
    "hybrid:demo:test": "bun test examples/hybrid-wasm-scenarios/scenarios.test.ts",
    "world-clock:demo": "bun run examples/saaa-world-clock/server.ts",
    "world-clock:test": "bun test examples/saaa-world-clock/world-clock.test.ts",
    "prompt": "bun run src/prompt-cli.ts",
    "llang": "bun run src/llang-cli.ts",
    "prompt:evaluate": "bun run src/prompt-evaluation.ts",
    "capability": "bun run src/capability-cli.ts",
    "capability:host": "bun run src/capability-host-cli.ts",
    "capability:host-kit": "bun run src/capability-host-kit.ts",
    "ci:llang-smoke": "bun run src/llang-smoke.ts",
    "ci:module-smoke": "bun run src/llang-module-smoke.ts",
    "ci:effects-smoke": "bun run src/llang-effects-smoke.ts",
    "effects:benchmark": "bun run src/effects-adversarial-cli.ts",
    "llvm:experiment:verify": "bun run src/llang-llvm-experiment.ts verify",
    "llvm:experiment:benchmark": "bun run src/llang-llvm-experiment.ts benchmark",
    "llvm:experiment:record": "bun run src/llang-llvm-experiment.ts record",
    "collection:memory": "bun run src/llang-collection-cost-cli.ts benchmarks/collection-memory-v1/benchmark.json benchmarks/collection-memory-v1/observations/latest.json",
    "collection:binaryen:verify": "bun run src/llang-collection-recipe-experiment.ts verify",
    "collection:binaryen:benchmark": "bun run src/llang-collection-recipe-experiment.ts benchmark",
    "collection:binaryen:report": "bun run src/llang-collection-recipe-experiment.ts report",
    "collection:binaryen:record": "bun run src/llang-collection-recipe-experiment.ts record",
    "collection:bottleneck:verify": "bun run src/llang-collection-bottleneck-experiment.ts verify",
    "collection:bottleneck:benchmark": "bun run src/llang-collection-bottleneck-experiment.ts benchmark",
    "collection:bottleneck:report": "bun run src/llang-collection-bottleneck-experiment.ts report",
    "collection:bottleneck:record": "bun run src/llang-collection-bottleneck-experiment.ts record",
    "collection:stability:verify": "bun run src/llang-collection-stability-experiment.ts verify",
    "collection:stability:benchmark": "bun run src/llang-collection-stability-experiment.ts benchmark",
    "collection:stability:report": "bun run src/llang-collection-stability-experiment.ts report",
    "collection:stability:record": "bun run src/llang-collection-stability-experiment.ts record",
    "collection:memory:matrix": "bun run src/llang-collection-memory-matrix.ts benchmarks/collection-memory-v1/memory-safety-matrix.json docs/COLLECTION_MEMORY_SAFETY_MATRIX.md",
    "value:memory:matrix": "bun run src/llang-value-memory-matrix.ts benchmarks/value-memory-v1/memory-safety-matrix.json docs/VALUE_WASM_MEMORY_SAFETY_MATRIX.md",
    "value:differential": "bun run src/llang-value-differential-cli.ts --seed 20260921 --cases 64 --failure-out artifacts/value-differential-failure.json",
    "effects:memory:matrix": "bun run src/llang-effects-memory-matrix.ts benchmarks/effects-memory-v1/memory-safety-matrix.json docs/EFFECTS_WASM_MEMORY_SAFETY_MATRIX.md",
    "examples:matrix": "bun run examples/source-output-matrix/run.ts",
    "examples:lifecycle": "bun run examples/capability-lifecycle/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.2",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "binaryen": "132.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.154.0",
    "jsonc-parser": "3.3.1"
  }
}
