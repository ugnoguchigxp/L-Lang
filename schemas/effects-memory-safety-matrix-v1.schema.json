{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/effects-memory-safety-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "profile", "abi", "entries"],
  "properties": {
    "format": { "const": "llang-effects-memory-safety-matrix" },
    "version": { "const": 1 },
    "profile": { "const": "module-effects-v1" },
    "abi": { "const": "llang-effects-session-v1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "guaranteedBy", "positive", "negative", "limitation"],
        "properties": {
          "id": { "type": "string", "pattern": "^EM[0-9]+$" },
          "subject": { "type": "string", "minLength": 1 },
          "guaranteedBy": { "type": "string", "minLength": 1 },
          "positive": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "negative": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "limitation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
