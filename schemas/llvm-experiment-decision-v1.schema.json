{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/llvm-experiment-decision-v1.schema.json",
  "title": "L-Lang LLVM experiment decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "createdOn", "outcome", "selectedOptimization", "wasmCandidates", "nativeOutcome", "rationale"],
  "properties": {
    "format": { "const": "llang-llvm-experiment-decision" }, "version": { "const": 1 },
    "createdOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "outcome": { "enum": ["expand-llvm-wasm", "maintain-current-backend"] },
    "selectedOptimization": { "type": ["string", "null"], "enum": ["O0", "O2", "O3", null] },
    "wasmCandidates": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["optimization", "comparisons", "artifactRatio", "qualifies"],
        "properties": {
          "optimization": { "enum": ["O0", "O2", "O3"] },
          "comparisons": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["caseId", "changePercent"],
              "properties": { "caseId": { "type": "string", "minLength": 1 }, "changePercent": { "type": "number" } }
            }
          },
          "artifactRatio": { "type": "number", "minimum": 0 }, "qualifies": { "type": "boolean" }
        }
      }
    },
    "nativeOutcome": { "const": "limited-experiment-only" }, "rationale": { "type": "string", "minLength": 1 }
  }
}
