{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/value-memory-safety-matrix-v1.schema.json",
  "title": "L-Lang Value memory safety matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "profile", "abi", "entries"],
  "properties": {
    "format": { "const": "llang-value-memory-safety-matrix" },
    "version": { "const": 1 },
    "profile": { "const": "module-value-v1" },
    "abi": { "const": "llang-value-memory-v1" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "guaranteedBy", "condition", "positive", "negative", "limitation"],
        "properties": {
          "id": { "type": "string", "pattern": "^VMM[0-9]+$" },
          "subject": { "type": "string", "minLength": 1 },
          "guaranteedBy": { "enum": ["compiler", "host-codec", "generated-wasm", "wasm-engine"] },
          "condition": { "type": "string", "minLength": 1 },
          "positive": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "negative": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "limitation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
