{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/llvm-experiment-corpus-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "kernel", "cases", "wasmBoundaryCases"],
  "properties": {
    "format": { "const": "llang-llvm-experiment-corpus" },
    "version": { "const": 1 },
    "kernel": { "const": "checked-sum-i32" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "wasmBoundaryCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boundary" } }
  },
  "$defs": {
    "i32": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "input": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "values"], "properties": { "kind": { "const": "explicit" }, "values": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/i32" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "value", "count"], "properties": { "kind": { "const": "repeat" }, "value": { "$ref": "#/$defs/i32" }, "count": { "type": "integer", "minimum": 0, "maximum": 4096 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "values", "count"], "properties": { "kind": { "const": "cycle" }, "values": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/i32" } }, "count": { "type": "integer", "minimum": 0, "maximum": 4096 } } }
      ]
    },
    "expected": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": { "status": { "const": 0 }, "value": { "$ref": "#/$defs/i32" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "overflowIndex"], "properties": { "status": { "const": 1 }, "overflowIndex": { "type": "integer", "minimum": 0, "maximum": 4095 } } }
      ]
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "partition", "input", "expected"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "partition": { "enum": ["correctness", "exploration", "holdout"] }, "input": { "$ref": "#/$defs/input" }, "expected": { "$ref": "#/$defs/expected" } }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "values", "count", "out", "expectedStatus"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "values": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "count": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "out": { "type": "integer", "minimum": 0, "maximum": 4294967295 }, "expectedStatus": { "type": "integer", "minimum": 0, "maximum": 2 } }
    }
  }
}
