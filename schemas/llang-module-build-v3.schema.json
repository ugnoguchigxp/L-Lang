{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/llang-module-build-v3.schema.json",
  "title": "L-Lang collection module build manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "profile",
    "abi",
    "entry",
    "sourceSetHash",
    "programHash",
    "loweredHash",
    "interfaceHash",
    "layoutHash",
    "resources",
    "sources",
    "dependencies",
    "targets",
    "artifacts",
    "toolchain"
  ],
  "properties": {
    "format": { "const": "llang-module-build" },
    "version": { "const": 3 },
    "profile": { "const": "module-collection-v1" },
    "abi": { "const": "llang-collection-memory-v1" },
    "entry": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "#"
    },
    "sourceSetHash": { "$ref": "#/$defs/hash" },
    "programHash": { "$ref": "#/$defs/hash" },
    "loweredHash": { "$ref": "#/$defs/hash" },
    "interfaceHash": { "$ref": "#/$defs/hash" },
    "layoutHash": { "$ref": "#/$defs/hash" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryPages",
        "stringBytes",
        "wireBytes",
        "listElements",
        "totalListElements",
        "arenaBytes",
        "fuel",
        "callDepth"
      ],
      "properties": {
        "memoryPages": { "const": 128 },
        "stringBytes": { "const": 16384 },
        "wireBytes": { "const": 262144 },
        "listElements": { "const": 4096 },
        "totalListElements": { "const": 16384 },
        "arenaBytes": { "const": 4194304 },
        "fuel": { "const": 1000000 },
        "callDepth": { "const": 64 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/source" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "enum": ["typescript", "jsonc", "wasm"] },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "wasm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "export", "contract", "wasmHash"],
      "properties": {
        "path": { "const": "wasm/program.wasm" },
        "export": { "const": "evaluate" },
        "contract": { "type": "object" },
        "wasmHash": { "$ref": "#/$defs/hash" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "binaryen", "typescript"],
      "properties": {
        "compiler": { "type": "string", "minLength": 1 },
        "binaryen": { "type": "string", "minLength": 1 },
        "typescript": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "targets": {
            "type": "array",
            "contains": { "const": "wasm" }
          }
        }
      },
      "then": { "properties": { "wasm": true }, "required": ["wasm"] },
      "else": {
        "not": {
          "properties": { "wasm": true },
          "required": ["wasm"]
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/safePath" },
        "to": { "$ref": "#/$defs/safePath" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "hash": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    }
  }
}
