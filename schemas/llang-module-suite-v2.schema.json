{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/llang-module-suite-v2.schema.json",
  "title": "L-Lang value module suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "profile", "interfaceHash", "cases"],
  "properties": {
    "format": { "const": "llang-module-suite" },
    "version": { "const": 2 },
    "profile": { "const": "module-value-v1" },
    "interfaceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cases": { "type": "array", "minItems": 1, "maxItems": 1024 }
  }
}
