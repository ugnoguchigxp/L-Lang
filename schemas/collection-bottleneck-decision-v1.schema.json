{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.local/schemas/collection-bottleneck-decision-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "outcome",
    "selectedTarget",
    "diagnosticLabel",
    "dataQuality",
    "qualityReasons",
    "mixWinner",
    "caseVoteWinner",
    "mixRankConsistent",
    "candidates",
    "rationale",
    "createdOn",
    "canonical"
  ],
  "properties": {
    "format": { "const": "llang-collection-bottleneck-decision" },
    "version": { "const": 1 },
    "outcome": { "enum": ["prioritize", "inconclusive"] },
    "selectedTarget": {
      "anyOf": [{ "$ref": "#/$defs/category" }, { "type": "null" }]
    },
    "diagnosticLabel": {
      "anyOf": [
        {
          "enum": [
            "compile",
            "instantiate",
            "encode",
            "validation",
            "allocation-copy",
            "kernel-ir",
            "mixed",
            "decode"
          ]
        },
        { "type": "null" }
      ]
    },
    "dataQuality": { "type": "boolean" },
    "qualityReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["unattributed-share", "timing-variation"] }
    },
    "mixWinner": {
      "anyOf": [{ "$ref": "#/$defs/category" }, { "type": "null" }]
    },
    "caseVoteWinner": {
      "anyOf": [{ "$ref": "#/$defs/category" }, { "type": "null" }]
    },
    "mixRankConsistent": { "type": "boolean" },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "createdOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "canonical": { "const": true }
  },
  "$defs": {
    "category": {
      "enum": ["startup", "host-input", "wasm-evaluate", "host-output"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "qualifyingCases",
        "qualifyingCaseIds",
        "robustCases",
        "robustCaseIds",
        "scalingConsistent",
        "scalingFailures",
        "mixShare",
        "medianShare",
        "intervalFloor",
        "absoluteNs",
        "eligible",
        "rejectionReasons"
      ],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "qualifyingCases": { "type": "integer", "minimum": 0 },
        "qualifyingCaseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "robustCases": { "type": "integer", "minimum": 0 },
        "robustCaseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "scalingFailures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "scalingConsistent": { "type": "boolean" },
        "mixShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "medianShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "intervalFloor": { "type": "number", "minimum": 0, "maximum": 1 },
        "absoluteNs": { "type": "number", "minimum": 0 },
        "eligible": { "type": "boolean" },
        "rejectionReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "insufficient-majority",
              "insufficient-robust-cases",
              "scaling-inconsistent",
              "mix-rank"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "prioritize" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "selectedTarget": { "$ref": "#/$defs/category" },
          "diagnosticLabel": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "inconclusive" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "selectedTarget": { "type": "null" },
          "diagnosticLabel": { "type": "null" }
        }
      }
    }
  ]
}
