{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/llvm-experiment-observation-v1.schema.json",
  "title": "L-Lang LLVM experiment observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "createdOn", "environment", "source", "benchmark", "samples", "summary"],
  "properties": {
    "format": { "const": "llang-llvm-experiment-observation" }, "version": { "const": 1 },
    "createdOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "environment": { "$ref": "llvm-experiment-freeze-v1.schema.json#/$defs/environment" },
    "source": { "$ref": "llvm-experiment-freeze-v1.schema.json#/$defs/source" },
    "benchmark": { "$ref": "llvm-experiment-benchmark-v1.schema.json" },
    "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sample" } },
    "summary": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/summary" } }
  },
  "$defs": {
    "partition": { "enum": ["exploration", "holdout"] },
    "lane": { "enum": ["reference", "product-wasm", "direct-wasm", "llvm-wasm-O0", "llvm-wasm-O2", "llvm-wasm-O3", "llvm-native-O0", "llvm-native-O2", "llvm-native-O3"] },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "partition", "lane", "sample", "scope", "nsPerIteration"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 }, "partition": { "$ref": "#/$defs/partition" },
        "lane": { "$ref": "#/$defs/lane" }, "sample": { "type": "integer", "minimum": 0 },
        "scope": { "enum": ["kernel", "end-to-end"] }, "nsPerIteration": { "type": "number", "minimum": 0 },
        "processNs": { "type": "number", "minimum": 0 }, "linearMemoryBytes": { "type": "integer", "minimum": 0 },
        "nativeBufferBytes": { "type": "integer", "minimum": 0 }, "peakRssBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "partition", "lane", "scope", "medianNs", "madNs", "p95Ns"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 }, "partition": { "$ref": "#/$defs/partition" },
        "lane": { "$ref": "#/$defs/lane" }, "scope": { "enum": ["kernel", "end-to-end"] }, "medianNs": { "type": "number", "minimum": 0 },
        "madNs": { "type": "number", "minimum": 0 }, "p95Ns": { "type": "number", "minimum": 0 }
      }
    }
  }
}
