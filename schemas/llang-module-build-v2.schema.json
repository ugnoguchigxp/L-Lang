{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.dev/schemas/llang-module-build-v2.schema.json",
  "title": "L-Lang value module build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "profile", "abi", "entry", "sourceSetHash", "programHash", "interfaceHash", "layoutHash", "resources", "sources", "dependencies", "targets", "artifacts", "toolchain"],
  "properties": {
    "format": { "const": "llang-module-build" },
    "version": { "const": 2 },
    "profile": { "const": "module-value-v1" },
    "abi": { "const": "llang-value-memory-v1" },
    "entry": { "type": "string" },
    "sourceSetHash": { "$ref": "#/$defs/hash" },
    "programHash": { "$ref": "#/$defs/hash" },
    "interfaceHash": { "$ref": "#/$defs/hash" },
    "layoutHash": { "$ref": "#/$defs/hash" },
    "resources": { "type": "object" },
    "sources": { "type": "array", "minItems": 1, "maxItems": 64 },
    "dependencies": { "type": "array", "maxItems": 1024 },
    "targets": { "type": "array", "items": { "enum": ["typescript", "jsonc", "wasm"] }, "uniqueItems": true },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 128 },
    "wasm": { "type": "object" },
    "toolchain": { "type": "object" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
