{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llang.dev/schemas/effects-dataset-provenance-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "mode",
    "author",
    "source",
    "license",
    "createdOn",
    "samplingFrame",
    "inclusion",
    "exclusion",
    "representativeness",
    "strata",
    "cases",
    "contamination"
  ],
  "properties": {
    "format": {
      "const": "llang-effects-dataset-provenance"
    },
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "fixture",
        "candidate",
        "reviewed"
      ]
    },
    "author": {
      "anyOf": [
        {
          "const": null
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        }
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "createdOn": {
      "anyOf": [
        {
          "const": null
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ]
    },
    "samplingFrame": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "inclusion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "exclusion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "representativeness": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "domain"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        }
      },
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "partition",
          "origin",
          "previouslyObserved",
          "sourceHash",
          "normalInputHash",
          "adversarialInputHash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "partition": {
            "enum": [
              "fixture",
              "pilot",
              "confirmatory"
            ]
          },
          "origin": {
            "enum": [
              "independent",
              "fixture-derived",
              "pilot-derived",
              "public-example",
              "observed-failure"
            ]
          },
          "previouslyObserved": {
            "type": "boolean"
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalInputHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "adversarialInputHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "uniqueItems": true
    },
    "contamination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "comparedCorpusHashes",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-run",
            "passed",
            "failed"
          ]
        },
        "comparedCorpusHashes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
