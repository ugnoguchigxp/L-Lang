{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "examples/**/*.ts",
      "pilots/**/*.ts",
      "!**/*.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "src/**/*.ts",
      "examples/**/*.ts",
      "pilots/**/*.ts",
      "!examples/**/semantic.ts"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
