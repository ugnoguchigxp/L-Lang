{
  "language": "l-lang",
  "version": 4,
  "kind": "module",
  "profile": "module-collection-v1",
  "imports": [
    { "from": "../domain/order.llang.jsonc", "bindings": [
      { "kind": "type", "name": "Input", "as": "Input" },
      { "kind": "type", "name": "Output", "as": "Output" }
    ] }
  ],
  "types": [],
  "functions": [
    {
      "name": "evaluate",
      "export": true,
      "typeParameters": [],
      "parameters": [{ "name": "input", "type": { "ref": "Input" } }],
      "returns": { "ref": "Output" },
      "body": {
        "statements": [
          { "kind": "const", "name": "filtered", "type": { "list": "i32" }, "value": {
            "kind": "intrinsic", "name": "filter", "typeArguments": [], "arguments": [
              { "kind": "field", "base": { "kind": "local", "name": "input" }, "name": "values" },
              { "kind": "lambda", "parameters": [{ "name": "value", "type": "i32" }], "returns": "boolean", "body": { "statements": [], "result": {
                "kind": "binary", "op": ">=", "left": { "kind": "local", "name": "value" }, "right": { "kind": "field", "base": { "kind": "local", "name": "input" }, "name": "threshold" }
              } } }
            ]
          } },
          { "kind": "const", "name": "sorted", "type": { "list": "i32" }, "value": {
            "kind": "intrinsic", "name": "stableSort", "typeArguments": [], "arguments": [
              { "kind": "local", "name": "filtered" },
              { "kind": "lambda", "parameters": [{ "name": "left", "type": "i32" }, { "name": "right", "type": "i32" }], "returns": "i32", "body": { "statements": [], "result": {
                "kind": "binary", "op": "-", "left": { "kind": "local", "name": "left" }, "right": { "kind": "local", "name": "right" }
              } } }
            ]
          } },
          { "kind": "const", "name": "total", "type": "i32", "value": {
            "kind": "intrinsic", "name": "fold", "typeArguments": [], "arguments": [
              { "kind": "local", "name": "sorted" },
              { "kind": "literal", "type": "i32", "value": 0 },
              { "kind": "lambda", "parameters": [{ "name": "sum", "type": "i32" }, { "name": "value", "type": "i32" }], "returns": "i32", "body": { "statements": [], "result": {
                "kind": "binary", "op": "+", "left": { "kind": "local", "name": "sum" }, "right": { "kind": "local", "name": "value" }
              } } }
            ]
          } },
          { "kind": "return", "value": { "kind": "record", "type": "Output", "typeArguments": [], "fields": [
            { "name": "values", "value": { "kind": "local", "name": "sorted" } },
            { "name": "total", "value": { "kind": "local", "name": "total" } }
          ] } }
        ]
      }
    }
  ]
}
