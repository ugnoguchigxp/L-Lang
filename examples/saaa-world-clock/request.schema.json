{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l-lang.example/schemas/saaa-world-clock-request-v1.json",
  "title": "SAAA World Clock Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "intent",
    "title",
    "subtitle",
    "accent",
    "locale",
    "cities"
  ],
  "properties": {
    "version": { "const": 1 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 160 },
    "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
    "cities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "timeZone", "group"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "timeZone": { "type": "string", "minLength": 1, "maxLength": 80 },
          "group": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  }
}
